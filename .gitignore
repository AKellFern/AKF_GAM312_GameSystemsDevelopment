# Keep project definition and core folders
!/*.uproject
!/Config/**
!/Source/**
!/Plugins/**
!/Content/**/*.uasset
!/Content/**/*.umap
!/RawContent/**

# Ignore build and generated data (no leading slash so this also catches
# per-plugin copies, e.g. Plugins/InteractionSystem/Binaries/)
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/

# Ignore packaged build output (e.g. from Package Project), which can be
# multiple GB and includes large .ucas/.utoc content archives
/PROJECT/

# Build artifacts
*.pdb
*.obj
*.exp
*.lib
*.dll
*.exe
*.so
*.app
*.apk
*.ipa
*.pak
*.zip

# IDE files
.vs/
.vscode/
.idea/
*.sln
*.vcxproj*
*.user
*.suo
*.sln.iml
*.code-workspace

# OS junk
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
._*
*~
.directory

# Temp and logs
*.log
*.tmp
*.bak
*.swp
*.swo
*.un~
